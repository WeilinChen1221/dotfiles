# Shared finder settings. Shell-specific preview quoting stays here.
export FZF_DEFAULT_COMMAND={{ .shell.fzfCommand | shellQuote }}
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS={{ .shell.fzfOptions | shellQuote }}
export _FZF_PREVIEW_CMD={{ .shell.fzfPreview | shellQuote }}
export FZF_CTRL_T_OPTS="--preview '$_FZF_PREVIEW_CMD'"

# Ctrl+F: file picker excluding hidden files
_fzf_file_no_hidden() {
  local cmd result
  cmd="${FZF_DEFAULT_COMMAND/--hidden /}"
  result=$(eval "${cmd:-find . -type f}" | fzf --preview "$_FZF_PREVIEW_CMD") \
    && LBUFFER+="$result"  # LBUFFER is the text left of the cursor
  zle reset-prompt
}
zle -N _fzf_file_no_hidden
